# Copy to .env and replace every placeholder before a staging/contest run.
POSTGRES_DB=brunost_judge
POSTGRES_USER=brunost
POSTGRES_PASSWORD=replace-with-a-long-random-password
BRUNOST_JUDGE_API_TOKEN=replace-with-a-long-random-api-token
BRUNOST_JUDGE_REQUIRE_API_TOKEN=true
BRUNOST_JUDGE_REQUIRE_WORKER_TOKEN=true
BRUNOST_JUDGE_CLUSTER_ID=country-cluster-1
BRUNOST_JUDGE_CALLBACK_SIGNING_SECRET=replace-with-a-long-random-callback-secret
BRUNOST_JUDGE_ENV=production
BRUNOST_JUDGE_SANDBOX_MODE=docker
BRUNOST_JUDGE_SANDBOX_IMAGE=ghcr.io/example/brunost-judge-runtime@sha256:replace-with-64-hex-digest
BRUNOST_JUDGE_SANDBOX_RUNTIME=runsc
BRUNOST_JUDGE_SANDBOX_SECCOMP=/etc/docker/seccomp/brunost-seccomp.json
BRUNOST_JUDGE_REQUIRE_SECCOMP=true
BRUNOST_JUDGE_REQUIRE_IMMUTABLE_ARTIFACTS=true
BRUNOST_JUDGE_LEASE_SECONDS=300
BRUNOST_JUDGE_BACKUP_DIR=/srv/brunost-judge/backups
# Set this to the callback receiver host(s), comma-separated.
BRUNOST_JUDGE_CALLBACK_HOSTS=platform.internal
