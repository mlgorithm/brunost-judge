{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlgorithm/brunost-judge/blob/main/schemas/task-manifest-v1.schema.json",
  "title": "Brunost Judge task manifest v1",
  "description": "Schema for flat v1 judge.yaml manifests. Package file and source validation remains authoritative.",
  "type": "object",
  "required": ["version", "kind"],
  "properties": {
    "version": {"const": 1},
    "kind": {
      "enum": ["agent", "coding", "game", "icpc", "interactive", "ioai", "optimization", "output-only", "quiz"]
    },
    "runner": {"type": "string"},
    "runtime": {"type": "string", "minLength": 1},
    "network": {"type": "string", "enum": ["disabled"]},
    "resource_class": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,49}$"},
    "required_capabilities": {
      "description": "A comma-separated string or a YAML inline list of worker capability labels.",
      "oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "maxItems": 32}]
    },
    "language": {"enum": ["python", "py", "c", "cpp", "c++", "c++17", "gnu++17", "g++", "rust", "rs"]},
    "time_limit_ms": {"type": "integer", "minimum": 1},
    "memory_limit_mb": {"type": "integer", "minimum": 1},
    "output_limit_bytes": {"type": "integer", "minimum": 1},
    "scoring_mode": {"enum": ["all_or_nothing", "percentage", "weighted"]},
    "answer_source": {"enum": ["answer_key", "reference"]},
    "scoring": {"type": "string"},
    "evaluation": {"const": "evaluator:evaluate"},
    "objective_direction": {"enum": ["maximize", "minimize"]},
    "score_mode": {"enum": ["checker_score", "baseline_ratio"]},
    "aggregation": {"enum": ["mean", "minimum", "geometric_mean"]},
    "answer_key": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["coding", "icpc"]}}, "required": ["kind"]},
      "then": {"required": ["runner", "language"], "properties": {"runner": {"const": "classic"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "quiz"}}, "required": ["kind"]},
      "then": {"required": ["runner"], "properties": {"runner": {"const": "quiz"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "optimization"}}, "required": ["kind"]},
      "then": {
        "required": ["runner", "language", "time_limit_ms", "memory_limit_mb", "output_limit_bytes", "evaluation", "objective_direction", "score_mode", "aggregation"],
        "properties": {"runner": {"const": "optimization"}}
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["agent", "game"]}}, "required": ["kind"]},
      "then": {"properties": {"runner": {"const": "python"}}}
    }
  ],
  "additionalProperties": true
}
