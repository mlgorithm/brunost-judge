{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlgorithm/brunost-judge/blob/main/schemas/task-manifest-v2.schema.json",
  "title": "Brunost Judge model task manifest v2",
  "description": "Schema for the train_predict_v2 model task contract.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "runner",
    "model_contract",
    "runtime",
    "evaluation",
    "time_limit_ms",
    "training_time_limit_ms",
    "prediction_time_limit_ms",
    "evaluator_time_limit_ms",
    "memory_limit_mb",
    "model_max_bytes",
    "training_dataset",
    "private_test_dataset",
    "private_labels_dataset"
  ],
  "properties": {
    "version": {"const": 2},
    "kind": {"const": "model"},
    "runner": {"const": "model"},
    "model_contract": {"const": "train_predict_v2"},
    "runtime": {"const": "python-3.13-ml-v1"},
    "evaluation": {"const": "evaluator:evaluate"},
    "network": {"type": "string", "enum": ["disabled"]},
    "time_limit_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
    "training_time_limit_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
    "prediction_time_limit_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
    "evaluator_time_limit_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
    "memory_limit_mb": {"type": "integer", "minimum": 64, "maximum": 16384},
    "model_max_bytes": {"type": "integer", "minimum": 1024, "maximum": 64000000},
    "training_dataset": {"type": "string", "pattern": "^public/datasets/"},
    "public_test_dataset": {"type": "string", "pattern": "^public/datasets/"},
    "public_labels_dataset": {"type": "string", "pattern": "^public/datasets/"},
    "private_test_dataset": {"type": "string", "pattern": "^private/datasets/"},
    "private_labels_dataset": {"type": "string", "pattern": "^private/datasets/"},
    "submission_entrypoint": {"type": "string"},
    "baseline_enabled": {"type": ["boolean", "string"]},
    "post_competition_enabled": {"type": ["boolean", "string"]}
  },
  "additionalProperties": true
}
