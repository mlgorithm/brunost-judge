# Production worker image: the worker process uses the host Docker socket only
# to launch short-lived evaluator containers under runsc/Kata. The API image
# should continue to use the smaller Dockerfile without a socket mount.
FROM docker:27-cli AS docker-cli
FROM python:3.13-slim

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[production]"

ENTRYPOINT ["brunost"]
