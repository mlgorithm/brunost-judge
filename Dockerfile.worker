# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Production worker image: the worker process reaches a constrained Docker
# socket proxy only to launch short-lived evaluator containers under runsc/Kata.
# The API image intentionally omits the Docker CLI.
ARG DOCKER_CLI_IMAGE=docker:27.5.1-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c
ARG PYTHON_IMAGE=python:3.13.15-slim@sha256:881d80734ee05dca6f7f42dcb080975652a53c7eda9ba1f03bb8da31aa6a6ec2
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5

FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_IMAGE}

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH \
    HOME=/home/brunost \
    TMPDIR=/tmp

# Build from the same checked-in, hash-verified lock as the API image. The
# Docker CLI is copied only into this worker image.
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --extra production --no-install-project --no-cache
COPY src ./src
RUN uv sync --locked --no-dev --extra production --no-cache \
    && rm --force /bin/uv /bin/uvx \
    && useradd --system --uid 10001 --create-home brunost \
    && mkdir --parents /tmp \
    && chown --recursive 10001:10001 /home/brunost /tmp

USER 10001:10001
ENTRYPOINT ["brunost"]
